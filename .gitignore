# Unanchored so nested crate target dirs (spikes/*/target) are covered too.
target/

# Design docs and ADRs are kept out of the public repository; the reasoning the
# code depends on is consolidated into README.md.
/docs

# Python bytecode from scripts/.
__pycache__/

# Local editing helper, not part of the project.
/scripts/edit.py

# cargo-fuzz working state. The targets are source; the corpus and any crash
# artifacts are local findings, and a corpus grows without bound.
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage
